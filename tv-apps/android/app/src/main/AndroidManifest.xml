<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional, never asked for on the TV: a computer can grant it over ADB so the app switches the
         Home button watch back on by itself after an update (FireWatch.kt). Without it the owner's
         Accessibility switch does the same job. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- See every app with a TV launcher entry, for the welcome page's app row. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The TV's own homes: the Home button watch and the crash guard look for them. -->
        <package android:name="com.amazon.tv.launcher" />
        <package android:name="com.google.android.apps.tv.launcherx" />
        <package android:name="com.google.android.tvlauncher" />
        <intent><action android:name="android.settings.ACCESSIBILITY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.HOME_SETTINGS" /></intent>
    </queries>

    <application
        android:name=".App"
        android:label="Guest TV"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:theme="@style/Guest"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The Home button watch (FireWatch.kt): off until the owner switches it on in the app's
             settings AND in the TV's Settings, Accessibility. It sees which window came forward and
             reads no screen content. -->
        <service
            android:name=".FireWatch"
            android:exported="false"
            android:label="Guest TV Home button watch"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/fire_watch" />
        </service>
        <!-- TCL only (TclPlaceholderInput.kt): an empty TV input so TCL's boot manager lets the
             watch start at boot. Off here, switched on at runtime on a TCL only. -->
        <service
            android:name=".TclPlaceholderInput"
            android:enabled="false"
            android:exported="true"
            android:label="Guest TV"
            android:permission="android.permission.BIND_TV_INPUT">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data android:name="android.media.tv.input" android:resource="@xml/tcl_placeholder_input" />
        </service>
        <receiver android:name=".FireWatch$Restore" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
